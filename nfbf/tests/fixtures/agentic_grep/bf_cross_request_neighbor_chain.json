{
  "id": "bf-cross-request-neighbor-chain",
  "purpose": "BF: same user+session, two request_ids, adjacent turns; Error seed must pull repair neighbor via enable_agentic_grep",
  "kernel": "coding-raw-bm25-v1",
  "config": "configs/coding-submit-nf-bf-v0.json",
  "enable_agentic_grep": true,
  "constraints": [
    "do-not-rerun official-smoke-20261028-r1",
    "no Full",
    "zero generative LLM / embedding for this local smoke"
  ],
  "adds": [
    {
      "request_id": "req-symptom",
      "user_id": "synthetic:bf-chain",
      "session_id": "sess-bf-1",
      "messages": [
        {
          "role": "user",
          "content": "Traceback (most recent call last):\n  File \"src/config.py\", line 12, in parseConfig\nValueError: UTF-8 BOM not stripped\n",
          "timestamp": 100
        }
      ]
    },
    {
      "request_id": "req-fix",
      "user_id": "synthetic:bf-chain",
      "session_id": "sess-bf-1",
      "messages": [
        {
          "role": "assistant",
          "content": "Fixed parseConfig: strip BOM before json load. tests PASSED for UTF-8 BOM case.\n",
          "timestamp": 200
        }
      ]
    },
    {
      "request_id": "req-noise",
      "user_id": "synthetic:bf-chain",
      "session_id": "sess-bf-1",
      "messages": [
        {
          "role": "user",
          "content": "Update CSS colors for navbar theme and footer padding.",
          "timestamp": 300
        }
      ]
    }
  ],
  "search": {
    "user_id": "synthetic:bf-chain",
    "query": "parseConfig UTF-8 BOM traceback fix",
    "top_k": 5
  },
  "expect": {
    "any_content_substrings": [
      "strip BOM",
      "PASSED",
      "ValueError"
    ],
    "top_hit_must_not_contain": "navbar theme",
    "min_hits": 1
  }
}
